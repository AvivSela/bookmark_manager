# Test Environment Variables for Enrichment Service
# These are dummy values - tests don't use real database or Kafka
# All external dependencies are mocked in tests

# Database Configuration (dummy values - not used by mocked tests)
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kafka Configuration (dummy values - not used by mocked tests)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=bookmarks.bookmark.created
KAFKA_CONSUMER_GROUP=enrichment-service-test
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_RECORDS=10

# Bookmark Service Configuration (dummy values - HTTP calls are mocked)
BOOKMARK_SERVICE_HOST=bookmark-service
BOOKMARK_SERVICE_PORT=8000
BOOKMARK_SERVICE_TIMEOUT_SECONDS=10

# Enrichment Configuration
ENRICHMENT_TIMEOUT_SECONDS=10
ENRICHMENT_MAX_ATTEMPTS=5
ENRICHMENT_INITIAL_RETRY_DELAY=0.01
ENRICHMENT_MAX_RETRY_DELAY=0.1
ENRICHMENT_BACKOFF_MULTIPLIER=2.0

# Application Settings
DEBUG=false
USER_AGENT="BookmarkEnricher/1.0 (+https://example.com/bot)"
