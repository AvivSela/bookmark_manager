# PostgreSQL Configuration
# Database username - used for authentication
POSTGRES_USER=bookmark_user

# Database password - change this in production!
POSTGRES_PASSWORD=bookmark_pass

# Database name - the main database to create
POSTGRES_DB=bookmark_db

# PostgreSQL port - default is 5432
POSTGRES_PORT=5432

# pgAdmin Configuration
# Email used to log into pgAdmin web interface
PGADMIN_DEFAULT_EMAIL=admin@example.com

# Password for pgAdmin login - change this in production!
PGADMIN_DEFAULT_PASSWORD=admin

# pgAdmin web interface port
PGADMIN_PORT=5050

# Kafka Configuration
# Kafka broker port - default is 9092
KAFKA_PORT=9092

# Kafdrop UI port - web interface for Kafka
KAFDROP_PORT=9000

# Kafka Producer Configuration
KAFKA_BOOTSTRAP_SERVERS=bookmark-kafka:9092
KAFKA_TOPIC_PREFIX=bookmarks
KAFKA_ENABLED=true
KAFKA_COMPRESSION_TYPE=gzip
KAFKA_MAX_RETRIES=3
KAFKA_REQUEST_TIMEOUT_MS=30000

# Bookmark Service Configuration
# Port for the bookmark REST API service
BOOKMARK_SERVICE_PORT=8000

# Enrichment Service Configuration
# Port for the enrichment service health endpoint
ENRICHMENT_SERVICE_PORT=8001

# Debug mode - set to true for development, false for production
DEBUG=false
