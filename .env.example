# PostgreSQL Configuration
# Database username - used for authentication
POSTGRES_USER=bookmark_user

# Database password - change this in production!
POSTGRES_PASSWORD=bookmark_pass

# Database name - the main database to create
POSTGRES_DB=bookmark_db

# PostgreSQL port - default is 5432
POSTGRES_PORT=5432

# pgAdmin Configuration
# Email used to log into pgAdmin web interface
PGADMIN_DEFAULT_EMAIL=admin@example.com

# Password for pgAdmin login - change this in production!
PGADMIN_DEFAULT_PASSWORD=admin

# pgAdmin web interface port
PGADMIN_PORT=5050

# Kafka Configuration
# Kafka broker port - default is 9092
KAFKA_PORT=9092

# Kafdrop UI port - web interface for Kafka
KAFDROP_PORT=9000
